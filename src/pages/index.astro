---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>AlliTech Solutions | Innovación y Tecnología</title>
	</head>
	<body class="bg-[#f8f6fa] text-gray-800 font-sans flex flex-col min-h-screen">
		
		<Navbar />

		<!-- HERO SECTION -->
		<header class="relative w-full h-[650px] md:h-[750px] overflow-hidden bg-gray-900 flex items-center">
			<div class="absolute inset-0 z-0">
				<div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent z-10"></div>
				<img src="/inicio/slide1.jpg" alt="AlliTech Solutions Oficina" class="w-full h-full object-cover object-center" />
			</div>

			<div class="relative z-20 max-w-6xl mx-auto px-6 w-full flex flex-col md:flex-row items-center justify-between">
				<div class="w-full md:w-1/2 text-center md:text-left mt-20 md:mt-0">
					<h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-tight drop-shadow-lg">
						Tu negocio en piloto automático con <span class="text-[#d9b3e6]">software a medida</span>
					</h1>
					<p class="text-lg md:text-xl text-gray-200 mb-10 max-w-lg mx-auto md:mx-0 drop-shadow-md">
						Creamos páginas web, sistemas y herramientas de gestión que automatizan tus procesos, aumentan tus ventas y te ahorran horas de trabajo.
					</p>
					<div class="flex flex-col sm:flex-row justify-center md:justify-start gap-4">
						<a href="https://wa.me/51903562285" target="_blank" class="bg-white text-[#6b4c5a] px-8 py-4 rounded-full font-bold hover:bg-gray-100 transition shadow-xl flex items-center justify-center gap-2 text-lg">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
							Cotizar mi proyecto
						</a>
						<a href="/soluciones" class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-full font-bold hover:bg-white/10 transition flex items-center justify-center gap-2 text-lg">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							Conocer soluciones
						</a>
					</div>
				</div>
				<div class="hidden md:block w-1/2"></div>
			</div>
		</header>

		<!-- BANNER DE CONFIANZA (Con SVGs profesionales) -->
		<div class="relative z-30 -mt-10 max-w-3xl mx-auto px-4">
			<div class="bg-white rounded-3xl shadow-xl flex justify-between items-center py-6 px-8">
				
				<!-- Item 1 -->
				<div class="text-center flex flex-col items-center">
					<svg class="w-8 h-8 text-[#6b4c5a] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
					<p class="font-bold text-gray-900 text-xl leading-tight">100%</p>
					<p class="text-sm text-gray-600 font-semibold">Funcional</p>
				</div>
				
				<!-- Divisor -->
				<div class="h-12 w-px bg-gray-200"></div>

				<!-- Item 2 -->
				<div class="text-center flex flex-col items-center">
					<svg class="w-8 h-8 text-[#6b4c5a] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
					<p class="font-bold text-gray-900 text-xl leading-tight">+10</p>
					<p class="text-sm text-gray-600 font-semibold">Tipos de Negocio</p>
				</div>

				<!-- Divisor -->
				<div class="h-12 w-px bg-gray-200"></div>

				<!-- Item 3 -->
				<div class="text-center flex flex-col items-center">
					<svg class="w-8 h-8 text-[#6b4c5a] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path></svg>
					<p class="font-bold text-gray-900 text-xl leading-tight">24/7</p>
					<p class="text-sm text-gray-600 font-semibold">Soporte Directo</p>
				</div>
			</div>
		</div>

				<!-- SOBRE ALLITECH -->
		<section class="py-20 max-w-6xl mx-auto px-4 mt-10">
			<div class="flex flex-col md:flex-row items-center gap-12">
				
				<div class="w-full md:w-1/2">
					<img src="/allison.jpg" alt="Allison - Fundadora" class="w-full h-auto rounded-3xl shadow-2xl object-cover border-4 border-white" />
				</div>

				<div class="w-full md:w-1/2">
					<h2 class="text-3xl font-bold text-[#3b1b4d] mb-4">Sobre <span class="text-[#8e2de2]">AlliTech Solutions</span></h2>
					<p class="text-lg text-gray-600 mb-8 leading-relaxed">
						Somos un aliado tecnológico que transforma ideas en soluciones reales. Ayudamos a emprendedores y empresas a digitalizar, automatizar y hacer crecer su negocio con tecnología simple, efectiva y segura.
					</p>
					
					<!-- Tarjetas de valores con el estilo de la propuesta -->
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
						<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center flex flex-col items-center justify-center hover:-translate-y-1 transition duration-300">
							<svg class="w-8 h-8 text-[#8e2de2] mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
							<p class="text-sm font-bold text-[#3b1b4d] leading-tight">Soluciones<br>personalizadas</p>
						</div>
						<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center flex flex-col items-center justify-center hover:-translate-y-1 transition duration-300">
							<svg class="w-8 h-8 text-[#8e2de2] mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
							<p class="text-sm font-bold text-[#3b1b4d] leading-tight">Tecnología<br>confiable</p>
						</div>
						<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center flex flex-col items-center justify-center hover:-translate-y-1 transition duration-300">
							<svg class="w-8 h-8 text-[#8e2de2] mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
							<p class="text-sm font-bold text-[#3b1b4d] leading-tight">Acompañamiento<br>real</p>
						</div>
					</div>

					<a href="/contacto" class="inline-block bg-[#3b1b4d] text-white px-8 py-3 rounded-full font-bold hover:bg-[#8e2de2] transition shadow-lg">
						Conoce más sobre mí &rarr;
					</a>
				</div>
			</div>
		</section>

		<!-- CÓMO TRABAJAMOS (Con fondo morado suave y estilo premium) -->
		<section class="py-20 bg-[#f3ebf7]">
			<div class="max-w-6xl mx-auto px-4 text-center">
				<h2 class="text-3xl font-bold text-[#3b1b4d] mb-4">¿Cómo trabajamos?</h2>
				<p class="text-gray-600 mb-16 text-lg">Un proceso simple, claro y sin complicaciones.</p>

				<div class="grid md:grid-cols-3 gap-8 relative">
					<!-- Paso 1 -->
					<div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 relative z-10 text-center flex flex-col items-center hover:shadow-xl transition duration-300">
						<div class="w-10 h-10 bg-[#6b4c5a] text-white rounded-full flex items-center justify-center text-lg font-bold absolute -top-5 shadow-lg border-4 border-white">1</div>
						<div class="w-16 h-16 bg-purple-50 rounded-full flex items-center justify-center mb-4 mt-2">
							<svg class="w-8 h-8 text-[#8e2de2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
						</div>
						<h3 class="text-xl font-bold text-[#3b1b4d] mb-2">Hablamos de tu negocio</h3>
						<p class="text-gray-600 text-sm leading-relaxed">Conocemos tus necesidades, ideas y objetivos.</p>
					</div>
					<!-- Paso 2 -->
					<div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 relative z-10 text-center flex flex-col items-center hover:shadow-xl transition duration-300">
						<div class="w-10 h-10 bg-[#6b4c5a] text-white rounded-full flex items-center justify-center text-lg font-bold absolute -top-5 shadow-lg border-4 border-white">2</div>
						<div class="w-16 h-16 bg-purple-50 rounded-full flex items-center justify-center mb-4 mt-2">
							<svg class="w-8 h-8 text-[#8e2de2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
						</div>
						<h3 class="text-xl font-bold text-[#3b1b4d] mb-2">Te mostramos tu solución</h3>
						<p class="text-gray-600 text-sm leading-relaxed">Preparamos una propuesta clara con el alcance, tiempo y precio.</p>
					</div>
					<!-- Paso 3 -->
					<div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 relative z-10 text-center flex flex-col items-center hover:shadow-xl transition duration-300">
						<div class="w-10 h-10 bg-[#6b4c5a] text-white rounded-full flex items-center justify-center text-lg font-bold absolute -top-5 shadow-lg border-4 border-white">3</div>
						<div class="w-16 h-16 bg-purple-50 rounded-full flex items-center justify-center mb-4 mt-2">
							<svg class="w-8 h-8 text-[#8e2de2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
						</div>
						<h3 class="text-xl font-bold text-[#3b1b4d] mb-2">Entregamos y te enseñamos</h3>
						<p class="text-gray-600 text-sm leading-relaxed">Recibes tu sistema 100% funcional y te guiamos en su uso.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA FINAL (Degradado morado intenso) -->
		<section class="py-20 bg-gradient-to-r from-[#2a1b3d] to-[#6b4c5a] text-white">
			<div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-8">
				<div class="w-full md:w-2/3 text-center md:text-left">
					<h2 class="text-4xl md:text-5xl font-extrabold mb-4">¿Listo para digitalizar tu negocio?</h2>
					<p class="text-lg text-white/80 mb-8 max-w-xl">Cotiza tu sistema hoy mismo y dale a tu negocio la tecnología que realmente necesita.</p>
					<a href="https://wa.me/51903562285" target="_blank" class="inline-block bg-white text-[#3b1b4d] px-10 py-4 rounded-full font-bold hover:bg-gray-100 transition shadow-xl text-lg transform hover:-translate-y-1">
						Cotizar por WhatsApp
					</a>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>
