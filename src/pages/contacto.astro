---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Contacto y Soporte | AlliTech Solutions</title>
	</head>
	<body class="bg-[#f8f6fa] text-gray-800 font-sans flex flex-col min-h-screen">
		
		<Navbar />

		<!-- ENCABEZADO MORADO -->
		<header class="relative w-full pt-20 pb-32 bg-gradient-to-br from-[#2a1b3d] via-[#4a2c5a] to-[#1a1124] overflow-hidden flex flex-col items-center justify-center text-center">
			<!-- Adorno de fondo simulando el diseño -->
			<div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-400 via-transparent to-transparent"></div>
			
			<div class="relative z-10 px-4">
				<!-- Ícono Superior -->
				<div class="w-20 h-20 mx-auto bg-white/10 backdrop-blur-sm border border-purple-500/30 rounded-2xl flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(168,85,247,0.4)]">
					<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path></svg>
				</div>
				
				<h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4 tracking-tight drop-shadow-lg">
					Contacto y <span class="text-[#d9b3e6]">Soporte</span>
				</h1>
				<p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto">
					Estamos aquí para ayudarte a hacer crecer tu negocio.
				</p>
				<!-- Línea decorativa inferior -->
				<div class="w-24 h-1 bg-gradient-to-r from-transparent via-[#d9b3e6] to-transparent mx-auto mt-8 rounded-full"></div>
			</div>
		</header>

		<!-- TARJETAS FLOTANTES -->
		<main class="flex-grow pb-20 relative z-20 -mt-16">
			<div class="max-w-6xl mx-auto px-4">
				<div class="grid md:grid-cols-2 gap-8">
					
					<!-- TARJETA 1: Ventas y Atención -->
					<div class="bg-white rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.08)] p-8 md:p-10 border border-gray-100 relative overflow-hidden">
						<div class="flex items-start gap-4 mb-6">
							<div class="w-14 h-14 bg-[#6b4c5a] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg">
								<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
							</div>
							<div>
								<h2 class="text-2xl font-bold text-gray-900 mb-2">Ventas y Atención al Cliente</h2>
								<p class="text-gray-600 text-sm leading-relaxed">
									¿Tienes dudas sobre nuestros programas, necesitas una cotización o quieres agendar una demostración? Contáctanos directamente.
								</p>
							</div>
						</div>

						<div class="space-y-4 mt-8">
							<!-- WhatsApp -->
							<a href="https://wa.me/51903562285" target="_blank" class="flex items-center justify-between p-4 bg-gray-50 hover:bg-gray-100 rounded-2xl border border-gray-200 transition group">
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
										<svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
									</div>
									<div>
										<p class="text-sm font-semibold text-gray-900">WhatsApp</p>
										<p class="text-sm text-gray-600">+51 903 562 285</p>
									</div>
								</div>
								<svg class="w-5 h-5 text-gray-400 group-hover:text-gray-900 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
							</a>

							<!-- Correo -->
							<a href="mailto:allitech.solutions.dev@gmail.com" class="flex items-center justify-between p-4 bg-gray-50 hover:bg-gray-100 rounded-2xl border border-gray-200 transition group">
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
										<svg class="w-5 h-5 text-[#6b4c5a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
									</div>
									<div>
										<p class="text-sm font-semibold text-gray-900">Correo Electrónico</p>
										<p class="text-sm text-gray-600">allitech.solutions.dev@gmail.com</p>
									</div>
								</div>
								<svg class="w-5 h-5 text-gray-400 group-hover:text-gray-900 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
							</a>

							<!-- Botón Reunión -->
							<a href="https://wa.me/51903562285?text=Hola%20Allison,%20quiero%20agendar%20una%20reuni%C3%B3n." target="_blank" class="mt-6 w-full flex items-center justify-center gap-2 bg-gradient-to-r from-[#6b4c5a] to-[#8a6375] text-white py-4 rounded-xl font-bold hover:from-[#523843] hover:to-[#6b4c5a] transition shadow-lg">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
								Agendar una Reunión
							</a>
						</div>
					</div>

					<!-- TARJETA 2: Libro de Reclamaciones (Morada) -->
					<div class="bg-[#2a1b3d] rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.2)] p-8 md:p-10 relative overflow-hidden flex flex-col justify-between border border-purple-500/20">
						<!-- Brillo de fondo -->
						<div class="absolute top-0 right-0 w-64 h-64 bg-purple-600/20 blur-3xl rounded-full"></div>
						
						<div class="relative z-10">
							<div class="flex items-start gap-4 mb-6">
								<div class="w-14 h-14 bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl flex items-center justify-center flex-shrink-0">
									<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
								</div>
								<div>
									<h2 class="text-2xl font-bold text-white mb-2">Libro de Reclamaciones</h2>
									<p class="text-gray-300 text-sm leading-relaxed">
										Conforme a lo establecido por el Código de Protección y Defensa del Consumidor, ponemos a tu disposición nuestro Libro de Reclamaciones Virtual. Tu opinión nos ayuda a mejorar.
									</p>
								</div>
							</div>

							<div class="bg-black/20 border border-white/10 rounded-2xl p-4 my-8 flex items-center justify-between">
								<div class="flex items-center gap-3">
									<svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
									<div>
										<p class="text-xs text-gray-400">Envia tu queja o reclamo a:</p>
										<p class="text-sm text-gray-200 font-medium">allitech.solutions.dev@gmail.com</p>
									</div>
								</div>
								<button class="text-gray-400 hover:text-white transition" title="Copiar correo">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
								</button>
							</div>
						</div>

						<a href="mailto:allitech.solutions.dev@gmail.com?subject=Hoja%20de%20Reclamaci%C3%B3n%20-%20AlliTech%20Solutions&body=Nombre%20completo:%0D%0ADNI:%0D%0ATel%C3%A9fono:%0D%0ADetalle%20del%20reclamo:" class="relative z-10 w-full flex items-center justify-center gap-2 bg-white text-[#2a1b3d] py-4 rounded-xl font-bold hover:bg-gray-100 transition shadow-lg">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
							Redactar Reclamo
							<svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
						</a>
					</div>
				</div>

				<!-- BANNER INFERIOR DE GARANTÍAS -->
				<div class="mt-12 bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-wrap justify-between items-center gap-6">
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 bg-purple-50 rounded-full flex items-center justify-center text-[#6b4c5a]">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
						</div>
						<p class="text-sm font-bold text-gray-800">Atención rápida<br><span class="font-normal text-gray-500 text-xs">y personalizada</span></p>
					</div>
					<div class="hidden md:block w-px h-10 bg-gray-200"></div>
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 bg-purple-50 rounded-full flex items-center justify-center text-[#6b4c5a]">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path></svg>
						</div>
						<p class="text-sm font-bold text-gray-800">Soporte técnico<br><span class="font-normal text-gray-500 text-xs">confiable</span></p>
					</div>
					<div class="hidden md:block w-px h-10 bg-gray-200"></div>
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 bg-purple-50 rounded-full flex items-center justify-center text-[#6b4c5a]">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
						</div>
						<p class="text-sm font-bold text-gray-800">Acompañamiento<br><span class="font-normal text-gray-500 text-xs">real</span></p>
					</div>
					<div class="hidden md:block w-px h-10 bg-gray-200"></div>
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 bg-purple-50 rounded-full flex items-center justify-center text-[#6b4c5a]">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
						</div>
						<p class="text-sm font-bold text-gray-800">Soluciones<br><span class="font-normal text-gray-500 text-xs">a tu medida</span></p>
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>