---
import '../../styles/global.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import TarjetaPrograma from '../../components/TarjetaPrograma.astro';
import { categorias } from '../../data/proyectos';

export function getStaticPaths() {
	return categorias.map((cat) => {
		return {
			params: { id: cat.id },
			props: { categoria: cat }
		};
	});
}

const { categoria } = Astro.props;
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{categoria.nombre} | AlliTech Solutions</title>
	</head>
	<body class="bg-[#f8f6fa] text-gray-800 font-sans flex flex-col min-h-screen">
		
		<Navbar />

		<main class="flex-grow py-12">
			<div class="max-w-7xl mx-auto px-4">
				
				<!-- Botón Volver -->
				<a href="/soluciones" class="text-[#6b4c5a] font-semibold mb-8 inline-flex items-center gap-2 hover:underline bg-white px-4 py-2 rounded-lg shadow-sm border border-gray-100 transition">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
					Volver al catálogo
				</a>
				
				<!-- Título de la Categoría -->
				<div class="mb-10 text-center md:text-left">
					<h1 class="text-4xl font-bold text-gray-900 mb-3">{categoria.nombre}</h1>
					<p class="text-gray-600 text-lg">{categoria.descripcion}</p>
				</div>

				<!-- Cuadrícula de Tarjetas (Igual que en Soluciones) -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{categoria.programas.map((prog) => (
						<TarjetaPrograma 
							titulo={prog.titulo} 
							descripcion={prog.descripcion} 
							video={prog.video} 
							categoria={categoria.nombre} 
						/>
					))}
				</div>

			</div>
		</main>

		<Footer />
	</body>
</html>