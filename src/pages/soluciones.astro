---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TarjetaPrograma from '../components/TarjetaPrograma.astro';
import { categorias } from '../data/proyectos'; 
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Proyectos | AlliTech Solutions</title>
	</head>
	<body class="bg-[#f8f6fa] text-gray-800 font-sans flex flex-col min-h-screen">
		
		<Navbar />

		<!-- ENCABEZADO MORADO CON IMÁGENES 3D -->
		<header class="relative w-full pt-12 pb-24 bg-gradient-to-r from-[#2a1b3d] via-[#4a2c5a] to-[#1a1124] overflow-hidden flex items-center justify-center">
			<!-- Brillo de fondo -->
			<div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-purple-400 via-transparent to-transparent"></div>
			
			<!-- Contenedor central -->
			<div class="relative z-10 max-w-7xl mx-auto px-4 w-full flex flex-col md:flex-row items-center justify-between gap-8">
				
				<!-- Laptop a la izquierda (Oculta en celular) -->
				<div class="hidden md:block w-1/4">
					<img src="/inicio/Laptop.png" alt="Laptop AlliTech" class="w-full h-auto object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-500" />
				</div>

				<!-- Texto Central -->
				<div class="w-full md:w-2/4 text-center">
					<h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4 tracking-tight drop-shadow-lg">
						Nuestros <span class="text-[#d9b3e6]">Proyectos</span>
					</h1>
					<p class="text-lg text-gray-300 max-w-xl mx-auto">
						Conoce las soluciones que hemos desarrollado para negocios como el tuyo.
					</p>
					<div class="w-24 h-1 bg-gradient-to-r from-transparent via-[#d9b3e6] to-transparent mx-auto mt-6 rounded-full"></div>
				</div>

				<!-- Ícono de código a la derecha (Oculto en celular) -->
				<div class="hidden md:block w-1/4 flex justify-end">
					<img src="/inicio/codigo.png" alt="Código AlliTech" class="w-3/4 h-auto object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-500" />
				</div>
				
			</div>
		</header>

		<main class="flex-grow py-12 relative z-20 -mt-8">
			<div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row gap-8">
				
				<!-- PANEL LATERAL IZQUIERDO (CATEGORÍAS) -->
				<aside class="w-full md:w-64 flex-shrink-0">
					<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 sticky top-24">
						<div class="flex items-center gap-2 mb-6 text-gray-900">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
							<h2 class="text-lg font-bold">Categorías</h2>
						</div>
						
												<ul class="space-y-2" id="lista-categorias">
							<!-- Botón para mostrar TODOS -->
							<li>
								<button class="categoria-btn w-full text-left px-4 py-3 rounded-xl font-medium bg-gradient-to-r from-[#3b1b4d] to-[#8e2de2] text-white flex items-center gap-3 transition shadow-md whitespace-nowrap" data-id="todos">
									<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
									Todos los Proyectos
								</button>
							</li>
							<!-- Botones generados por las categorías de tu proyectos.ts -->
							{categorias.map((cat) => (
								<li>
									<button class="categoria-btn w-full text-left px-4 py-3 rounded-xl font-medium text-gray-600 hover:bg-gray-50 flex items-center gap-3 transition" data-id={cat.id}>
										<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
										{cat.nombre}
									</button>
								</li>
							))}
						</ul>
					</div>
				</aside>

				<!-- CONTENIDO DERECHO (BUSCADOR Y TARJETAS) -->
				<section class="w-full md:w-3/4">
					
					<!-- Buscador -->
					<div class="flex flex-col md:flex-row gap-4 mb-8 relative">
						<div class="relative flex-grow">
							<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
								<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
							</div>
							<input type="text" id="buscador" placeholder="Buscar proyectos..." class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#8e2de2] bg-white shadow-sm text-gray-700">
						</div>
					</div>

					<!-- Contenedor donde se inyectan las tarjetas -->
					<div id="contenido-categoria" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
						<!-- El JavaScript llenará esto -->
					</div>
				</section>
			</div>
		</main>

		<Footer />

				<!-- PASAMOS LOS DATOS A JS -->
		<script type="application/json" id="datos-categorias" set:html={JSON.stringify(categorias)}></script>

				<!-- SCRIPT PARA FILTRAR -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				// Le decimos a TypeScript que estos elementos existen usando "as HTMLElement"
				const datosCategorias = JSON.parse(document.getElementById('datos-categorias')?.innerText || '[]');
				const botones = document.querySelectorAll('.categoria-btn');
				const contenedor = document.getElementById('contenido-categoria') as HTMLElement;
				const buscador = document.getElementById('buscador') as HTMLInputElement;
				
				let categoriaActual = 'todos';

				const dibujarTarjetas = (idCat: string, filtro: string = '') => {
					contenedor.innerHTML = ''; 
					let programasAMostrar: any[] = [];

					if (idCat === 'todos') {
						datosCategorias.forEach((cat: any) => {
							cat.programas.forEach((prog: any) => {
								programasAMostrar.push({ ...prog, categoriaNombre: cat.nombre });
							});
						});
					} else {
						const catEncontrada = datosCategorias.find((c: any) => c.id === idCat);
						if (catEncontrada) {
							catEncontrada.programas.forEach((prog: any) => {
								programasAMostrar.push({ ...prog, categoriaNombre: catEncontrada.nombre });
							});
						}
					}

					if (filtro) {
						programasAMostrar = programasAMostrar.filter((p: any) => 
							p.titulo.toLowerCase().includes(filtro.toLowerCase()) || 
							p.descripcion.toLowerCase().includes(filtro.toLowerCase())
						);
					}

					if (programasAMostrar.length === 0) {
						contenedor.innerHTML = `<div class="col-span-2 text-center py-10 text-gray-500">No se encontraron proyectos.</div>`;
						return;
					}

					programasAMostrar.forEach((prog: any) => {
						const card = document.createElement('div');
						card.className = 'bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300 hover:-translate-y-1';
						
						const videoSrc = prog.video.startsWith('/') ? prog.video : `/${prog.video}`;

						card.innerHTML = `
							<div class="relative h-56 bg-black overflow-hidden cursor-pointer">
								<div class="absolute top-4 left-4 z-20 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-[#3b1b4d] flex items-center gap-1 shadow-sm pointer-events-none">
									🎯 ${prog.categoriaNombre}
								</div>
								<video src="${videoSrc}" controls class="w-full h-full object-cover"></video>
							</div>
							<div class="p-6 flex flex-col flex-grow">
								<h3 class="text-xl font-bold text-gray-900 mb-2">${prog.titulo}</h3>
								<p class="text-gray-600 text-sm flex-grow leading-relaxed line-clamp-3">${prog.descripcion}</p>
							</div>
						`;
						contenedor.appendChild(card);
					});
				};

				botones.forEach(btn => {
					btn.addEventListener('click', (e) => {
						// Aquí arreglamos el error de 'EventTarget'
						const target = e.currentTarget as HTMLElement;
						const id = target.getAttribute('data-id') || 'todos';
						categoriaActual = id;
						
						botones.forEach(b => {
							const btnElement = b as HTMLElement;
							btnElement.classList.remove('bg-[#6b4c5a]', 'text-white', 'shadow-md');
							btnElement.classList.add('text-gray-600', 'hover:bg-gray-50');
						});
						target.classList.remove('text-gray-600', 'hover:bg-gray-50');
						target.classList.add('bg-[#6b4c5a]', 'text-white', 'shadow-md');

						buscador.value = '';
						dibujarTarjetas(id);
					});
				});

				buscador.addEventListener('input', (e) => {
					// Aquí arreglamos el error del buscador
					const target = e.target as HTMLInputElement;
					dibujarTarjetas(categoriaActual, target.value);
				});

				dibujarTarjetas('todos');
			});
		</script>
	</body>
</html>